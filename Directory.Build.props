<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CI)' != 'true'">
    <BaseIntermediateOutputPath>C:\tmp\CryptoDockBuildNet10\$(MSBuildProjectName)\obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>C:\tmp\CryptoDockBuildNet10\$(MSBuildProjectName)\bin\</BaseOutputPath>
    <RestorePackagesPath>C:\tmp\CryptoDockPackages</RestorePackagesPath>
  </PropertyGroup>
</Project>
